# Copy this file to .env and change the passwords and tokens.
# .env is git-ignored: never commit it. Guide 1 explains every setting.
#
# Run these from the project folder. They work the same on Windows, macOS and Linux.
#   A password (run it once for each):  uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
#   A token (run it once for each):     uv run python -m insurance_mcp.auth

# --- Database -----------------------------------------------------------------

# The admin (postgres) password for the local Docker database.
# Docker reads it only when it first creates the database.
POSTGRES_PASSWORD=change-me-admin-password

# The admin connection string, used only by the setup command and the data generator.
# Its password must match POSTGRES_PASSWORD above.
# 127.0.0.1 rather than localhost: Docker only listens on 127.0.0.1, and on some
# machines localhost tries the IPv6 address (::1) first.
ADMIN_DATABASE_URL=postgresql://postgres:change-me-admin-password@127.0.0.1:5432/insurance

# The read-only connection string, used by the MCP server.
# The setup command takes the password from here and sets it on the mcp_reader role.
READER_DATABASE_URL=postgresql://mcp_reader:change-me-reader-password@127.0.0.1:5432/insurance

# --- MCP server ---------------------------------------------------------------

# Named tokens, as name:token pairs separated by commas. The name decides which
# customers a token sees: local sees them all. Guide 3 ends by adding one token
# per client (claude, copilot, inspector), each of which sees part of the data.
# Every token must be at least 32 characters. Make each one with the token command at the top.
MCP_TOKENS=local:replace-with-a-generated-token

# Host names the server answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Calls allowed per caller.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=1000

# Most database connections the server opens at once.
DB_POOL_MAX_SIZE=5

# Where the server listens. 127.0.0.1 means this machine only.
HOST=127.0.0.1
PORT=8000
